SecretBase_Text_Trainer0Intro:
	.string "Cậu đã làm SECRET BASE chưa?\p"
	.string "Tớ đã đi hết chỗ này đến chỗ khác rồi\n"
	.string "mới chọn nơi đây.\p"
	.string "Cậu đã đến tận đây rồi, đấu với tớ một\n"
	.string "trận nhé?$"

SecretBase_Text_Trainer0AcceptBattle:
	.string "Được! Bọn tớ lên đây!$"

SecretBase_Text_Trainer0DeclineBattle:
	.string "Hả? À, giờ cậu không đấu được sao.$"

SecretBase_Text_Trainer0Defeated::
	.string "Oa! Cậu mạnh quá! Chuyện tớ thua, làm\n"
	.string "ơn giữ bí mật nhé!$"

SecretBase_Text_Trainer0PostBattle:
	.string "Cậu thấy SECRET BASE của tớ thế nào?\n"
	.string "Ngày mai lại đến chơi nhé.$"

SecretBase_Text_Trainer0PreChampion:
	.string "Cậu đã làm SECRET BASE chưa?\p"
	.string "Tớ đã đi hết chỗ này đến chỗ khác rồi\n"
	.string "mới chọn nơi đây.\p"
	.string "Cứ tự nhiên ở lại chơi nhé!$"

SecretBase_Text_Trainer5Intro:
	.string "Có rất nhiều nơi để làm SECRET BASE.\p"
	.string "Nhưng tớ thích chỗ này nhất. Cậu không\n"
	.string "thấy nó đẹp sao?\p"
	.string "À, cậu có muốn đấu một trận không?$"

SecretBase_Text_Trainer5AcceptBattle:
	.string "Được, bắt đầu thôi!$"

SecretBase_Text_Trainer5DeclineBattle:
	.string "À, giờ cậu không đấu được sao. Được\n"
	.string "thôi.$"

SecretBase_Text_Trainer5Defeated::
	.string "Hừm. Bọn tớ thua rồi. Nhưng đừng kể\n"
	.string "với ai nhé! Đây là bí mật tuyệt mật!$"

SecretBase_Text_Trainer5PostBattle:
	.string "Nếu lại đến khu vực này, tớ mong cậu sẽ\n"
	.string "ghé thăm.$"

SecretBase_Text_Trainer5PreChampion:
	.string "Có rất nhiều nơi để làm SECRET BASE.\p"
