SecretBase_Text_Trainer1Intro:
	.string "Chỗ này được ưa chuộng lắm, lúc nào\n"
	.string "cũng có người chiếm.\p"
	.string "Ơ! Cậu cũng định lấy chỗ này sao?\p"
	.string "Thế này nhé, nếu đánh bại được tớ thì\n"
	.string "chỗ này sẽ thuộc về cậu.$"

SecretBase_Text_Trainer1AcceptBattle:
	.string "Được! Tớ sẽ bảo vệ SECRET BASE của\n"
	.string "mình!$"

SecretBase_Text_Trainer1DeclineBattle:
	.string "Hả? Vậy sao? Cậu không hứng thú với\n"
	.string "chỗ này à?$"

SecretBase_Text_Trainer1Defeated::
	.string "Tớ không trụ nổi nữa! Tớ đầu hàng!$"

SecretBase_Text_Trainer1PostBattle:
	.string "Được rồi, ngày nào đó khi tớ chuyển đi,\n"
	.string "nơi này sẽ thuộc về cậu!$"

SecretBase_Text_Trainer1PreChampion:
	.string "Chỗ này được ưa chuộng lắm, lúc nào\n"
	.string "cũng có người chiếm.\p"
	.string "Tớ đã chờ rất lâu mới thấy nó trống.\n"
	.string "Cuối cùng tớ cũng được dùng rồi!$"

SecretBase_Text_Trainer6Intro:
	.string "Chào mừng đến với POKéMON LAB của tôi.\p"
	.string "Tôi bí mật nghiên cứu về chiến đấu.\p"
	.string "Bạn có muốn xem tôi mạnh đến đâu\n"
	.string "không?$"

SecretBase_Text_Trainer6AcceptBattle:
	.string "Tôi sẽ dốc toàn lực!$"

SecretBase_Text_Trainer6DeclineBattle:
	.string "Ồ. Vậy để lần khác nhé!$"

SecretBase_Text_Trainer6Defeated::
	.string "Hừm. Tôi vẫn còn nhiều điều phải học.\n"
	.string "Tôi cần nghiên cứu thêm.$"

SecretBase_Text_Trainer6PostBattle:
	.string "Cảm ơn bạn đã đấu với tôi. Ngày mai hãy\n"
	.string "quay lại nhé.$"

SecretBase_Text_Trainer6PreChampion:
	.string "Chào mừng đến với POKéMON LAB của tôi.\p"
	.string "Tôi bí mật nghiên cứu về chiến đấu.$"

SecretBase_Text_Trainer2Intro:
	.string "Biệt thự lớn cũng hay, nhưng tớ thích\n"
	.string "kiểu nơi này hơn.\p"
	.string "Tớ thích vì đủ kiểu người sẽ đến thăm.\p"
	.string "Vậy cậu có muốn đấu một trận không?$"

SecretBase_Text_Trainer2AcceptBattle:
	.string "Phải thế chứ!$"

SecretBase_Text_Trainer2DeclineBattle:
	.string "Khi nào sẵn sàng thì gọi tớ nhé!$"

SecretBase_Text_Trainer2Defeated::
	.string "Ôi! Bị hạ mất rồi! Nhưng chiến đấu vẫn\n"
	.string "vui thật!$"

SecretBase_Text_Trainer2PostBattle:
	.string "Dù sao thì tớ cũng nên đi mua thêm đồ\n"
	.string "trang trí và nội thất.\p"
	.string "Tớ muốn SECRET BASE của mình trở\n"
	.string "thành nơi mà mọi người đều có thể vui\l"
	.string "chơi.$"

SecretBase_Text_Trainer2PreChampion:
