	.string "Tớ thích vì đủ kiểu người sẽ đến thăm.$"

SecretBase_Text_Trainer7Intro:
	.string "Tôi vô cùng thích mua đồ trang trí và\n"
	.string "nội thất.\p"
	.string "Tôi cũng yêu thích việc nuôi dưỡng\n"
	.string "POKéMON không kém.\p"
	.string "Nếu bạn không phiền, hãy đấu với\n"
	.string "POKéMON của tôi nhé?$"

SecretBase_Text_Trainer7AcceptBattle:
	.string "Cảm ơn bạn. Chúng ta bắt đầu nhé?$"

SecretBase_Text_Trainer7DeclineBattle:
	.string "Ồ. Thật đáng tiếc.$"

SecretBase_Text_Trainer7Defeated::
	.string "Tôi xin nhận thua.$"

SecretBase_Text_Trainer7PostBattle:
	.string "Trận đấu thật vui! Giờ tôi nên đi tận\n"
	.string "hưởng việc mua sắm thôi.$"

SecretBase_Text_Trainer7PreChampion:
	.string "Tôi vô cùng thích mua đồ trang trí và\n"
	.string "nội thất.\p"
	.string "Tôi cũng yêu thích việc nuôi dưỡng\n"
	.string "POKéMON không kém.$"

SecretBase_Text_Trainer3Intro:
	.string "Có người xây SECRET BASE ở những nơi\n"
	.string "rất khó tìm. Họ chỉ muốn ẩn mình thôi\l"
	.string "sao?\p"
	.string "Nhưng cậu đã tìm thấy tớ rồi, chúng ta\n"
	.string "đấu một trận nhé?$"

SecretBase_Text_Trainer3AcceptBattle:
	.string "Tớ sẽ không dễ dàng gục ngã đâu!$"

SecretBase_Text_Trainer3DeclineBattle:
	.string "À. Có phải cậu mệt vì phải tìm nơi này\n"
	.string "không?$"

SecretBase_Text_Trainer3Defeated::
	.string "Tớ gục mất rồi.$"

SecretBase_Text_Trainer3PostBattle:
	.string "SECRET BASE của cậu ở đâu? Tớ nên đến\n"
	.string "thăm mới được.$"

SecretBase_Text_Trainer3PreChampion:
	.string "Có người xây SECRET BASE ở những nơi\n"
	.string "rất khó tìm. Họ chỉ muốn ẩn mình thôi\l"
	.string "sao?$"

SecretBase_Text_Trainer8Intro:
