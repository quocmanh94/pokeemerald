	.string "Chúng ta nên thi xem ai kiếm được đồ\n"
	.string "trang trí và nội thất đẹp hơn!$"

SecretBase_Text_Trainer4Intro:
	.string "Tớ tìm được một chỗ ưng ý rồi bày biện\n"
	.string "bằng những món đồ trang trí mình thích\l"
	.string "nhất.\p"
	.string "Tớ nuôi POKéMON yêu thích và cùng nó\n"
	.string "trở nên mạnh hơn.\p"
	.string "Đó là việc tớ vẫn làm. Cậu muốn đấu với\n"
	.string "tớ không?$"

SecretBase_Text_Trainer4AcceptBattle:
	.string "Cho tớ xem bản lĩnh của cậu nào!$"

SecretBase_Text_Trainer4DeclineBattle:
	.string "Chắc cũng có lúc cậu không có hứng.$"

SecretBase_Text_Trainer4Defeated::
	.string "Giờ thì tớ biết chính xác cậu có bản\n"
	.string "lĩnh thế nào rồi.$"

SecretBase_Text_Trainer4PostBattle:
	.string "Cả hai ta đều có thể mạnh hơn. Cùng\n"
	.string "tiếp tục cố gắng nhé!$"

SecretBase_Text_Trainer4PreChampion:
	.string "Tớ tìm được một chỗ ưng ý rồi bày biện\n"
	.string "bằng những món đồ trang trí mình thích\l"
	.string "nhất.\p"
	.string "Tớ nuôi POKéMON yêu thích và cùng nó\n"
	.string "trở nên mạnh hơn.\p"
	.string "Ngày nào cũng thật tuyệt.$"

SecretBase_Text_Trainer9Intro:
	.string "Nhìn vào loại đồ trang trí một người\n"
	.string "sở hữu và cách họ trưng bày, ta có thể\l"
	.string "biết nhiều về gu thẩm mỹ và óc tinh tế\l"
	.string "của họ.\p"
	.string "Cậu thấy gu của tớ thế nào? Đẹp đến\n"
	.string "mức không nói nên lời sao?\p"
	.string "Muốn xem phong cách chiến đấu của tớ\n"
	.string "không?$"

SecretBase_Text_Trainer9AcceptBattle:
	.string "Không cần nương tay!$"

SecretBase_Text_Trainer9DeclineBattle:
	.string "Lúc nào tớ cũng sẵn lòng phô diễn phong\n"
	.string "cách của mình.$"

SecretBase_Text_Trainer9Defeated::
	.string "Cậu tài giỏi tuyệt đỉnh! Sức mạnh của\n"
	.string "cậu dường như không có giới hạn.$"

SecretBase_Text_Trainer9PostBattle:
	.string "Cậu thấy phong cách của tớ thế nào? Tớ\n"
	.string "sẽ tiếp tục trau chuốt nó!$"

SecretBase_Text_Trainer9PreChampion:
	.string "Nhìn vào loại đồ trang trí một người\n"
	.string "sở hữu và cách họ trưng bày, ta có thể\l"
	.string "biết nhiều về gu thẩm mỹ và óc tinh tế\l"
	.string "của họ.\p"
	.string "Cậu thấy gu của tớ thế nào? Đẹp đến\n"
