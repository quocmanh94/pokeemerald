EventTicket_Text_ShowOldSeaMap:
	.string "Chuyến phà đến SLATEPORT thì...\p"
	.string "Xin lỗi, gì cơ? Chúng ta có thể đi\n"
	.string "thuyền đến nơi này trên bản đồ sao?\p"
	.string "Tôi biết một người có thể giúp bạn tốt\n"
	.string "hơn. Xin hãy chờ.$"

EventTicket_Text_ThatPass:
	.string "Chuyến phà đến SLATEPORT thì...\p"
