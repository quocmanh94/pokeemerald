gLocalizationEnglish_A00380:
	.string "Before starting the battle, would you\n"
	.string "like to swap a POKéMON?$"

gLocalizationEnglish_A00381:
	.string "Thank you!\n"
	.string "Your POKéMON swap is complete.$"

gLocalizationEnglish_A00382:
